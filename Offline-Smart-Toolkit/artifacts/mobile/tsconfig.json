{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "jsx": "react-native",
    "strict": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "expo-router": ["./lib/native/router"],
      "expo-status-bar": ["./lib/native/status-bar"],
      "expo-splash-screen": ["./lib/native/splash-screen"],
      "expo-clipboard": ["./lib/native/clipboard"],
      "expo-linear-gradient": ["./lib/native/linear-gradient"],
      "@expo/vector-icons": ["./lib/native/icons"],
      "@expo-google-fonts/inter": ["./lib/native/google-fonts-inter"],
      "expo-image-manipulator": ["./lib/native/image-manipulator"],
      "expo-image": ["./lib/native/image"],
      "expo-document-picker": ["./lib/native/document-picker"],
      "expo-file-system": ["./lib/native/file-system"],
      "expo-file-system/legacy": ["./lib/native/file-system-legacy"],
      "expo-image-picker": ["./lib/native/image-picker"],
      "expo-sharing": ["./lib/native/sharing"],
      "expo-media-library": ["./lib/native/media-library"],
      "expo-camera": ["./lib/native/camera"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "shims/*.ts",
    "shims/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "dist",
    "server",
    "scripts"
  ]
}
